# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose overrides (optional)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler_pass
POSTGRES_DB=email_scheduler
POSTGRES_PORT=5432

REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# Backend — copy this block into backend/.env
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# The URL of your React frontend (used for CORS + OAuth redirect)
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://scheduler:scheduler_pass@localhost:5432/email_scheduler

# Redis connection string
REDIS_URL=redis://localhost:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# Worker / Queue tuning
# ─────────────────────────────────────────────────────────────────────────────
# Number of parallel jobs the BullMQ worker will process simultaneously
WORKER_CONCURRENCY=5

# BullMQ global rate-limiter: max N jobs per DURATION_MS across all workers
# e.g. 1 job per 2000ms = minimum 2 seconds between any two email sends
RATE_LIMITER_MAX=1
RATE_LIMITER_DURATION_MS=2000

# Per-sender hourly cap (Redis-backed, multi-worker safe)
# When reached, jobs are re-scheduled to the next hour — never dropped
MAX_EMAILS_PER_HOUR_PER_SENDER=200
