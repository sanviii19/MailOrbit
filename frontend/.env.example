# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables — EXAMPLE
# Copy this to .env.local for local development.
# In production (Vercel), set these in the Vercel dashboard under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL — used by axios in src/services/api.ts
# Development:
# VITE_API_URL=http://localhost:4000/api

# Production (replace with your actual Render backend URL):
# VITE_API_URL=https://email-job-scheduler.onrender.com/api
